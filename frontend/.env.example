# ============================================================================
# Configuração da API — Infinity Frontend
# Copie este arquivo para `.env` e ajuste os valores.
# ============================================================================

# --- Desenvolvimento (npm run dev) -----------------------------------------
# Backend local. O Vite faz proxy de /api e /uploads para este endereço,
# então o navegador continua falando com http://localhost:5173 (sem CORS).
# Ajuste a porta se o SERVER_PORT do backend for diferente.
VITE_API_URL_LOCAL=http://localhost:8089

# --- Produção (npm run build) ----------------------------------------------
# URL pública da API, usada para montar as requisições no bundle final.
# Ex.: https://api.infinity.gg
# Deixe VAZIO se o backend servir o frontend na mesma origem (mesmo domínio).
VITE_API_URL_PUBLIC=

# --- Compatibilidade --------------------------------------------------------
# Nomes antigos, ainda aceitos como fallback:
# VITE_PROXY_TARGET=http://localhost:8089
# VITE_API_URL=https://api.exemplo.com
