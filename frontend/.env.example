# Destino do proxy do Vite em desenvolvimento (backend Express).
# Ajuste se o SERVER_PORT do backend for diferente.
VITE_PROXY_TARGET=http://localhost:8089

# Opcional: use quando o frontend for servido separado da API (ex.: produção).
# Deixe vazio para consumir via proxy em /api.
# VITE_API_URL=https://sua-api.exemplo.com
