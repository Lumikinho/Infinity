  generator client {
    provider = "prisma-client"
    output   = "../src/generated/prisma"
  }

  datasource db {
    provider = "postgresql"
  }

  model Users {
    UUID       String   @id @default(uuid())
    name       String
    email      String   @unique
    password   String
    profilePic String?
    role       UserRole
    createdAt  DateTime @default(now())
    updatedAt  DateTime @updatedAt
  }

  enum UserRole {
    USER
    ADMIN
    PLAYER
  }
