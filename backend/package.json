{
  "name": "infinity-backend",
  "version": "1.0.0",
  "description": "Backend da Infinity",
  "main": "index.js",
  "scripts": {
    "dev": "bun --watch src/server.ts",
    "start": "bun src/server.ts",
    "check": "bun --bun tsc --noEmit",
    "fmt": "bun x prettier --write .",
    "db:generate": "bunx --bun prisma generate",
    "db:push": "bunx --bun prisma db push",
    "db:studio": "bunx --bun prisma studio",
    "db:crud": "bun src/main.ts",
    "postinstall": "prisma generate"
  },
  "keywords": [],
  "type": "module",
  "dependencies": {
    "@prisma/adapter-neon": "^7.10.1",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "dotenv": "^18.0.9",
    "elysia": "^1.4.30",
    "express": "^5.3.0",
    "fastify": "^5.12.7",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@types/bun": "^1.4.4",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.5",
    "prisma": "^8.0.0-rc.27",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
