{
  "name": "infinity-backend",
  "version": "1.0.0",
  "private": true,
  "description": "Backend da Infinity",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "dev:bun": "bun --watch src/server.ts",
    "build": "prisma generate && tsc",
    "start": "bun src/server.ts",
    "start:node": "tsx src/server.ts",
    "check": "tsc --noEmit",
    "fmt": "prettier --write .",
    "db:g": "prisma generate",
    "db:m": "prisma migrate dev"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1158.0",
    "@aws-sdk/s3-request-presigner": "^3.1158.0",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "@types/bcrypt": "^6.0.0",
    "bcrypt": "^6.0.0",
    "cors": "^2.8.5",
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "multer": "^2.5.0",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.3.0",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.0.0",
    "prettier": "^3.0.0",
    "prisma": "^7.10.1",
    "tsx": "^4.23.15",
    "typescript": "^5.0.0"
  }
}
