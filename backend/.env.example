SERVER_PORT=

SALTS=

# development | production
# O Neon Object Storage só é usado quando NODE_ENV=production.
NODE_ENV=development

# Pooled connection, used by the app at runtime.
# Neon Console -> Connect -> Connection string (pooled). Host contains "-pooler".
DATABASE_URL=""

# Direct (unpooled) connection, used by the Prisma CLI (migrations, db push, introspection).
# Neon Console -> Connect -> Connection string (direct). Host does NOT contain "-pooler".
DATABASE_URL_UNPOOLED=""

# Neon Object Storage (S3-compatible) — usado apenas em produção.
# Puxe as credenciais do branch de produção com `neon env pull` ou copie do console.
# O bucket precisa existir no branch. O endpoint é específico do branch.
S3_BUCKET=uploads
AWS_ENDPOINT_URL_S3=""
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_REGION=""
