SERVER_PORT=

SALTS=

# Pooled connection, used by the app at runtime.
# Neon Console -> Connect -> Connection string (pooled). Host contains "-pooler".
DATABASE_URL=""

# Direct (unpooled) connection, used by the Prisma CLI (migrations, db push, introspection).
# Neon Console -> Connect -> Connection string (direct). Host does NOT contain "-pooler".
DATABASE_URL_UNPOOLED=""
